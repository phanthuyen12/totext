backend/storage/outputs/*
!backend/storage/outputs/.gitkeep
backend/storage/mongo-data/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*

# OS/editor noise and logs
.DS_Store
**/.DS_Store
*.log
