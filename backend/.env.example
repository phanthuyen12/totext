PORT=4000

# Redis (BullMQ queues + voices cache only - job/segment data lives in SQLite)
REDIS_URL=redis://127.0.0.1:6379

# SQLite (persistent storage for jobs + segments, relative to backend/)
SQLITE_PATH=storage/voicetext.sqlite3

# Resona.live API (https://resona.live) - text-to-speech
RESONA_API_BASE=https://resona.live
RESONA_REQUEST_TIMEOUT_MS=120000
RESONA_API_KEY=

# Video splitting
SEGMENT_SECONDS=60

# faster-whisper (speech-to-text)
# Point this at your venv's python if you created one, e.g. ./.venv/bin/python
WHISPER_PYTHON=python3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Storage paths (relative to backend/)
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs

# CORS
FRONTEND_ORIGIN=http://localhost:5173
